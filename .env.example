# Copy to .env (git-ignored) or export these in your shell. Never put real values in this file.
# GitHub token for the github MCP server: a fine-grained token with read access to issues and
# pull requests on this repo (add write access only if you want the agent to comment).
GITHUB_TOKEN=
# The db MCP server's login. The default is the read-only dev user from scripts/db-readonly-user.sh.
HELLOBILL_READONLY_DB_URL=postgresql://hellobill_readonly:readonly@localhost:5432/hellobill
