{
  "mcpServers": {
    "github": {
      "command": "github-mcp-server",
      "args": [
        "stdio",
        "--toolsets",
        "issues,pull_requests"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "browser": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.86",
        "--headless",
        "--isolated"
      ]
    },
    "db": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres@0.6.2",
        "${HELLOBILL_READONLY_DB_URL:-postgresql://hellobill_readonly:readonly@localhost:5432/hellobill}"
      ]
    }
  }
}
