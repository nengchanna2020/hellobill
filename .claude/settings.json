{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "permissions": {
    "allow": [
      "Edit(/frontend/src/**)",
      "Edit(/frontend/e2e/**)",
      "Edit(/backend/src/**)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run format *)",
      "Bash(npm run typecheck *)",
      "Bash(npx vitest run *)",
      "Bash(backend/gradlew -p backend test *)",
      "Bash(backend/gradlew -p backend spotlessApply *)",
      "Bash(backend/gradlew -p backend spotlessCheck *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(bash .claude/skills/db-migration/scripts/check-migration.sh)",
      "Bash(node .claude/skills/responsive-layout-check/scripts/screens.mjs *)",
      "mcp__github__issue_read",
      "mcp__github__list_issues",
      "mcp__github__search_issues",
      "mcp__github__pull_request_read",
      "mcp__github__list_pull_requests",
      "mcp__browser__browser_navigate",
      "mcp__browser__browser_snapshot",
      "mcp__browser__browser_take_screenshot",
      "mcp__browser__browser_click",
      "mcp__browser__browser_wait_for",
      "mcp__browser__browser_resize",
      "mcp__browser__browser_close",
      "mcp__db__query"
    ],
    "ask": [
      "Bash(git push *)",
      "mcp__github__add_issue_comment",
      "mcp__github__create_pull_request"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(**/.env)",
      "Bash(rm *)",
      "Bash(docker compose down *)",
      "Bash(*DROP TABLE*)",
      "Bash(*drop table*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/settings.json)",
      "mcp__github__merge_pull_request",
      "mcp__github__issue_write",
      "mcp__github__update_pull_request_branch",
      "mcp__github__sub_issue_write"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "backend/gradlew -p backend *",
      "tail *",
      "head *",
      "grep *",
      "bash .claude/skills/db-migration/scripts/check-migration.sh",
      "node .claude/skills/responsive-layout-check/scripts/screens.mjs *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.gradle",
        "~/.npm"
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "repo.maven.apache.org",
        "plugins.gradle.org",
        "services.gradle.org"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-context.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-secrets.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-approved-spec.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-on-edit.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-related-tests.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-green-tests.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code needs you\" with title \"HelloBill\"' 2>/dev/null || notify-send HelloBill 'Claude Code needs you' 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "github",
    "browser",
    "db"
  ]
}
