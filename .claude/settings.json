{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "permissions": {
    "allow": [
      "Edit(/frontend/src/**)",
      "Edit(/frontend/e2e/**)",
      "Edit(/backend/src/**)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run format *)",
      "Bash(npm run typecheck *)",
      "Bash(npx vitest run *)",
      "Bash(backend/gradlew -p backend test *)",
      "Bash(backend/gradlew -p backend spotlessApply *)",
      "Bash(backend/gradlew -p backend spotlessCheck *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Bash(rm *)",
      "Bash(docker compose down *)",
      "Bash(*DROP TABLE*)",
      "Bash(*drop table*)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "backend/gradlew -p backend *",
      "tail *",
      "head *",
      "grep *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.gradle",
        "~/.npm"
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "repo.maven.apache.org",
        "plugins.gradle.org",
        "services.gradle.org"
      ]
    }
  }
}
